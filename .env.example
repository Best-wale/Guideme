# ==========================================
# AI Site Guide - Environment Variables
# ==========================================

# Backend API Configuration
# Used by extension to connect to backend
REACT_APP_API_URL=http://localhost:3000

# ==========================================
# OpenAI Configuration
# ==========================================
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# ==========================================
# AWS Configuration
# ==========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here

# ==========================================
# Optional: Advanced Configuration
# ==========================================

# DynamoDB Table Names (defaults work if you follow setup guide)
DYNAMODB_SESSIONS_TABLE=ai-site-guide-sessions
DYNAMODB_MESSAGES_TABLE=ai-site-guide-messages
DYNAMODB_FEEDBACK_TABLE=ai-site-guide-feedback

# Session TTL (in seconds, default 86400 = 24 hours)
SESSION_TTL=86400

# Message History TTL (in seconds, default 2592000 = 30 days)
MESSAGE_TTL=2592000

# Enable Debug Logging
DEBUG=false
