{
  "manifest_version": 3,
  "name": "AI Site Guide",
  "description": "AI-powered visual guidance for websites with voice I/O and real-time assistance",
  "version": "1.0.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/entrypoints/background.ts"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/entrypoints/content.tsx"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/entrypoints/popup.html",
    "default_title": "AI Site Guide"
  },
  "icons": {
    "16": "src/assets/icon-16.png",
    "48": "src/assets/icon-48.png",
    "128": "src/assets/icon-128.png"
  }
}
